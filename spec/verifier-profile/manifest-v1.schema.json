{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shield.cash/spec/verifier-profile/manifest-v1.schema.json",
  "title": "shield.cash verifier-profile bundle manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifacts", "genesis", "identity", "network", "profile", "schema", "setup", "standard", "toolchain"],
  "properties": {
    "schema": {"const": "shield.cash/verifier-profile-manifest/v1"},
    "standard": {"$ref": "#/$defs/standard"},
    "profile": {"$ref": "#/$defs/profile"},
    "setup": {"$ref": "#/$defs/setup"},
    "toolchain": {"$ref": "#/$defs/toolchain"},
    "network": {"$ref": "#/$defs/network"},
    "artifacts": {"type": "array", "minItems": 6, "items": {"$ref": "#/$defs/artifact"}},
    "identity": {"$ref": "#/$defs/identity"},
    "genesis": {"$ref": "#/$defs/genesis"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "label": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "standard": {"type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": {"id": {"const": "shield.cash"}, "version": {"const": "1"}}},
    "profile": {"type": "object", "additionalProperties": false, "required": ["constraintSystemHash", "curve", "proofSystem", "publicInputAbi", "relation"], "properties": {"proofSystem": {"const": "groth16"}, "curve": {"const": "bn254"}, "relation": {"$ref": "#/$defs/namedHash"}, "constraintSystemHash": {"$ref": "#/$defs/hash"}, "publicInputAbi": {"$ref": "#/$defs/namedHash"}}},
    "namedHash": {"type": "object", "additionalProperties": false, "required": ["id", "sha256"], "properties": {"id": {"$ref": "#/$defs/label"}, "sha256": {"$ref": "#/$defs/hash"}}},
    "toolchain": {"type": "object", "additionalProperties": false, "required": ["compiler", "generator"], "properties": {"compiler": {"$ref": "#/$defs/tool"}, "generator": {"$ref": "#/$defs/tool"}}},
    "tool": {"type": "object", "additionalProperties": false, "required": ["name", "sha256", "version"], "properties": {"name": {"$ref": "#/$defs/label"}, "version": {"type": "string", "minLength": 1, "maxLength": 128}, "sha256": {"$ref": "#/$defs/hash"}}},
    "network": {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"const": "chipnet"}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "path", "sha256"], "properties": {"id": {"$ref": "#/$defs/label"}, "kind": {"enum": ["relation-definition", "constraint-system", "public-input-abi", "verification-key", "proving-key", "bch-verifier-script", "ceremony-transcript"]}, "path": {"type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$"}, "sha256": {"$ref": "#/$defs/hash"}}},
    "identity": {"type": "object", "additionalProperties": false, "required": ["profileId"], "properties": {"profileId": {"$ref": "#/$defs/hash"}}},
    "genesis": {"type": "object", "additionalProperties": false, "required": ["genesisOutpoint", "instanceId", "network", "profileId", "reserveCapSatoshis"], "properties": {"profileId": {"$ref": "#/$defs/hash"}, "instanceId": {"$ref": "#/$defs/hash"}, "network": {"const": "chipnet"}, "genesisOutpoint": {"$ref": "#/$defs/outpoint"}, "reserveCapSatoshis": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,18})$"}}},
    "outpoint": {"type": "object", "additionalProperties": false, "required": ["txid", "vout"], "properties": {"txid": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "vout": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,9})$"}}},
    "setup": {"oneOf": [{"$ref": "#/$defs/developmentSetup"}, {"$ref": "#/$defs/ceremonySetup"}]},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["initializerCommitment", "method"], "properties": {"method": {"enum": ["local-initialization", "multi-party-randomness"]}, "initializerCommitment": {"$ref": "#/$defs/hash"}}},
    "verifier": {"type": "object", "additionalProperties": false, "required": ["name", "sha256", "version"], "properties": {"name": {"$ref": "#/$defs/label"}, "version": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"}}},
    "developmentSetup": {"type": "object", "additionalProperties": false, "required": ["contributions", "mode", "provenance", "transcript"], "properties": {"mode": {"const": "development-only"}, "provenance": {"$ref": "#/$defs/provenance"}, "transcript": {"type": "object", "additionalProperties": false, "required": ["status"], "properties": {"status": {"const": "not-applicable"}}}, "contributions": {"type": "array", "maxItems": 0}}},
    "ceremonySetup": {"type": "object", "additionalProperties": false, "required": ["contributions", "mode", "provenance", "transcript"], "properties": {"mode": {"const": "ceremony-production"}, "provenance": {"$ref": "#/$defs/provenance"}, "transcript": {"type": "object", "additionalProperties": false, "required": ["artifactPath", "sha256", "status", "verifier"], "properties": {"status": {"const": "complete"}, "artifactPath": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"}, "verifier": {"$ref": "#/$defs/verifier"}}}, "contributions": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/contribution"}}}},
    "contribution": {"type": "object", "additionalProperties": false, "required": ["contributionHash", "participantCommitment", "sequence", "verification"], "properties": {"sequence": {"type": "string", "pattern": "^[1-9][0-9]*$"}, "participantCommitment": {"$ref": "#/$defs/hash"}, "contributionHash": {"$ref": "#/$defs/hash"}, "verification": {"type": "object", "additionalProperties": false, "required": ["status", "verifier"], "properties": {"status": {"const": "verified"}, "verifier": {"$ref": "#/$defs/verifier"}}}}}
  }
}
