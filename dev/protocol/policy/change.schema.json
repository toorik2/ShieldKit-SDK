{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shield.cash/schema/change/v1",
  "title": "shield.cash frozen-direction change record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "rfc",
    "oldFreeze",
    "newFreeze",
    "changedDecisions",
    "invalidatedGates",
    "invalidatedEvidence",
    "reason"
  ],
  "properties": {
    "schema": {"const": "shield.cash/change/v1"},
    "rfc": {"type": "string", "pattern": "^RFC-[0-9]{4}$"},
    "oldFreeze": {"type": "string"},
    "newFreeze": {"type": "string"},
    "changedDecisions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^D-[0-9]{3}$"},
      "uniqueItems": true
    },
    "invalidatedGates": {
      "type": "array",
      "minItems": 1,
      "items": {"pattern": "^G[0-9]$"},
      "uniqueItems": true
    },
    "invalidatedEvidence": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "reason": {"type": "string", "minLength": 1}
  }
}
