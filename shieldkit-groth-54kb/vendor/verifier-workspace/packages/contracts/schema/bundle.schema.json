{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verifier.cash/candidate-bundle/v1",
  "type": "object",
  "required": ["schema", "runId", "candidateId", "lane", "candidateManifestSha256", "sourceCommit", "files", "judge"],
  "properties": {
    "schema": { "const": "verifier.cash/candidate-bundle/v1" },
    "runId": { "type": "string" },
    "candidateId": { "type": "string" },
    "lane": { "type": "string" },
    "candidateManifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceCommit": { "type": "string" },
    "files": { "type": "object" },
    "judge": { "type": "object" }
  }
}
