  ([0x53,0x54,0x95], 2, 0, 0, 3, 3),
  ([0x55,0x53,0x96], 2, 0, 0, 3, 3),
  ([0x55,0x53,0x97], 2, 0, 0, 3, 3),
  ([0x52,0x8b], 1, 0, 0, 2, 2),
  ([0x52,0x8c], 1, 0, 0, 2, 2),
  ([0x52,0x8f], 1, 0, 0, 2, 2),
  ([0x52,0x90], 1, 0, 0, 2, 2),
  ([0x02,0x2c,0x01,0x02,0x90,0x01,0x93], 2, 0, 0, 6, 3),
  ([0x01,0x42,0xa8], 0, 1, 0, 33, 2),
  ([0x01,0x42,0xa9], 0, 2, 0, 21, 2),
  ([0x01,0x42,0xaa], 0, 2, 0, 33, 2),
  ([0x01,0x42,0xa6], 0, 1, 0, 21, 2),
  ([0x01,0x42,0xa7], 0, 1, 0, 21, 2),
  ([0x28,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0xa8], 0, 1, 0, 72, 2),
  ([0x28,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0xaa], 0, 2, 0, 72, 2),
  ([0x51,0x52,0x7e], 0, 0, 0, 4, 3),
  ([0x01,0x42,0x01,0x42,0x7e], 0, 0, 0, 4, 3),
  ([0x52,0x55,0x80], 0, 0, 0, 7, 3),
  ([0x55,0x76], 0, 0, 0, 2, 2),
