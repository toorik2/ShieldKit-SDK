]

/-- Build-time DIFFERENTIAL: for every committed libauth vector, LeanBCH's metered run must produce
    the identical five raw metrics. Throws (fails `lake build`) on the first mismatch. -/
def costDifferentialGuard : IO Unit := do
  for v in costVectors do
    let (bs, ai, hi, sc, pb, ei) := v
    let m := (fnRun bs).metrics
    unless m.arithmeticCost == ai && m.hashDigestIterations == hi && m.signatureCheckCount == sc
        && m.stackPushedBytes == pb && m.evaluatedInstructionCount == ei do
      throw (IO.userError s!"[cost differential] script {bs}: LeanBCH ({m.arithmeticCost},{m.hashDigestIterations},{m.signatureCheckCount},{m.stackPushedBytes},{m.evaluatedInstructionCount}) ≠ libauth ({ai},{hi},{sc},{pb},{ei})")

#eval costDifferentialGuard

end LeanBCH.Validation
