{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shieldkit/v2-stark/state-v1",
  "title": "shieldkit-v2-stark-sks3-state-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profileId",
    "noteRoot",
    "nullifierRoot",
    "noteCount",
    "nullifierCount",
    "maximumLiveNotes",
    "reserveSats",
    "actionSequence"
  ],
  "properties": {
    "profileId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "noteRoot": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nullifierRoot": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "noteCount": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "nullifierCount": { "type": "integer", "minimum": 0, "maximum": 4294967294 },
    "maximumLiveNotes": { "type": "integer", "minimum": 1 },
    "reserveSats": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "actionSequence": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" }
  }
}
