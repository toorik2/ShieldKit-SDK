{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shieldkit/v2-stark/runtime-material-v1",
  "title": "shieldkit-v2-stark-runtime-material-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "eligibility",
    "profileId",
    "instanceId",
    "relationId",
    "friParamId",
    "airId",
    "topologyId",
    "verifierRoles",
    "bindingRedeemSha256",
    "stateRedeemSha256",
    "materialSha256"
  ],
  "properties": {
    "schema": { "const": "shieldkit-v2-stark-runtime-material-v1" },
    "eligibility": {
      "type": "string",
      "enum": ["development-only", "beta-unqualified", "final"]
    },
    "profileId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "instanceId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "relationId": { "const": "shieldkit-pool-action-v2-stark" },
    "friParamId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "airId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "topologyId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "verifierRoles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "redeemSha256", "maxUnlockBytes"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "redeemSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "maxUnlockBytes": { "type": "integer", "minimum": 1, "maximum": 10000 }
        }
      }
    },
    "bindingRedeemSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "stateRedeemSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "materialSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
