{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shieldkit/v2-stark/settlement-assembly-v1",
  "title": "shieldkit-v2-stark-settlement-assembly-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "topologyId",
    "statement",
    "verifierUnlockingHex",
    "bindingUnlockingHex",
    "stateUnlockingHex",
    "funding",
    "outputs"
  ],
  "properties": {
    "schema": { "const": "shieldkit-v2-stark-settlement-assembly-v1" },
    "topologyId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "statement": { "$ref": "statement.schema.json" },
    "verifierUnlockingHex": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^([0-9a-f]{2})+$" }
    },
    "bindingUnlockingHex": { "type": "string", "pattern": "^([0-9a-f]{2})+$" },
    "stateUnlockingHex": { "type": "string", "pattern": "^([0-9a-f]{2})+$" },
    "funding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outpoint", "lockingBytecodeHex", "valueSats"],
      "properties": {
        "outpoint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}:[0-9]+$"
        },
        "lockingBytecodeHex": { "type": "string", "pattern": "^([0-9a-f]{2})+$" },
        "valueSats": { "type": "integer", "minimum": 1 }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["valueSats", "lockingBytecodeHex"],
        "properties": {
          "valueSats": { "type": "integer", "minimum": 0 },
          "lockingBytecodeHex": { "type": "string", "pattern": "^([0-9a-f]{2})+$" },
          "token": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "category": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "commitment": { "type": "string", "pattern": "^[0-9a-f]{256}$" },
              "amount": { "type": "integer", "const": 0 },
              "capability": { "const": "mutable" }
            }
          }
        }
      }
    }
  }
}
