{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verifier.cash/candidate/v1",
  "type": "object",
  "required": ["schema", "id", "lane", "status", "capability", "toolchain", "build", "judge", "provenance"],
  "properties": {
    "schema": { "const": "verifier.cash/candidate/v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "lane": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "status": { "enum": ["research", "measured", "promoted"] },
    "capability": { "type": "object" },
    "toolchain": { "type": "object" },
    "build": {
      "type": "object",
      "properties": {
        "adapter": { "enum": ["artifact-bundle", "lane-module"] },
        "module": { "type": "string" },
        "profile": { "type": "object" }
      }
    },
    "judge": {
      "type": "object",
      "properties": {
        "execution": {
          "type": "object",
          "properties": {
            "kind": { "enum": ["covenant-chain", "singleton-size"] },
            "category": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        },
        "expected": {
          "type": "object",
          "properties": {
            "lockingBytes": { "type": "integer", "minimum": 1 },
            "lockingSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "operationCost": { "type": "integer", "minimum": 1 },
            "inputsForHeaviestStep": { "type": "integer", "minimum": 1 },
            "proofsTested": { "type": "integer", "minimum": 1 },
            "artifactHashes": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "provenance": { "type": "object" }
  }
}
