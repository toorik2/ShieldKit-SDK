{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verifier.cash/evidence/v1",
  "type": "object",
  "required": ["schema", "runId", "candidateId", "tier", "verdict", "checks"],
  "properties": {
    "schema": { "const": "verifier.cash/evidence/v1" },
    "runId": { "type": "string" },
    "candidateId": { "type": "string" },
    "tier": { "enum": ["fast", "qualification", "promotion"] },
    "verdict": { "enum": ["green", "red"] },
    "checks": { "type": "array", "minItems": 1 }
  }
}
