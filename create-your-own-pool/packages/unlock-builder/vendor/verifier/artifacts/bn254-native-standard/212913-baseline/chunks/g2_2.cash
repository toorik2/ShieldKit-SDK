pragma cashscript ^0.14.0;
import "../../../singleton/bn254/lib/Miller_aff.cash";
contract G2CheckAff() {
    function spend(int RXa,int RXb,int RYa,int RYb,int Bxa,int Bxb,int Bya,int Byb,int nAx,int nAy,int Cx,int Cy,int input0,int input1,int ld50a,int ld50b,int ld51a,int ld51b,int la51a,int la51b,int ld52a,int ld52b,int ld53a,int ld53b,int ld54a,int ld54b,int la54a,int la54b,int ld55a,int ld55b,int la55a,int la55b,int ld56a,int ld56b,int la56a,int la56b,int ld57a,int ld57b,int la57a,int la57b,int ld58a,int ld58b,int la58a,int la58b,int ld59a,int ld59b,int ld60a,int ld60b,int ld61a,int ld61b,int ld62a,int ld62b,int la62a,int la62b,int le1a,int le1b,int le2a,int le2b,int le3a,int le3b,int lera,int lerb, bytes unused zeroPadding) {
        require(tx.inputs[this.activeInputIndex].nftCommitment == hash256((((toPaddedBytes(RXa, 40) + (toPaddedBytes(RXb, 40) + toPaddedBytes(RYa, 40))) + ((toPaddedBytes(RYb, 40) + toPaddedBytes(Bxa, 40)) + (toPaddedBytes(Bxb, 40) + toPaddedBytes(Bya, 40)))) + ((toPaddedBytes(Byb, 40) + (toPaddedBytes(nAx, 40) + toPaddedBytes(nAy, 40))) + ((toPaddedBytes(Cx, 40) + toPaddedBytes(Cy, 40)) + (toPaddedBytes(input0, 40) + toPaddedBytes(input1, 40)))))));
        (int v0,int v1,int v2,int v3) = g2AffDbl(RXa,RXb,RYa,RYb, ld50a, ld50b);
        (int v4,int v5,int v6,int v7) = g2AffDbl(v0,v1,v2,v3, ld51a, ld51b);
        (int v8,int v9,int v10,int v11) = g2AffAdd(v4,v5,v6,v7, Bxa,Bxb,Bya,Byb, la51a, la51b);
        (int v12,int v13,int v14,int v15) = g2AffDbl(v8,v9,v10,v11, ld52a, ld52b);
        (int v16,int v17,int v18,int v19) = g2AffDbl(v12,v13,v14,v15, ld53a, ld53b);
        (int v20,int v21,int v22,int v23) = g2AffDbl(v16,v17,v18,v19, ld54a, ld54b);
        (int v24,int v25,int v26,int v27) = g2AffAdd(v20,v21,v22,v23, Bxa,Bxb,Bya,Byb, la54a, la54b);
        (int v28,int v29,int v30,int v31) = g2AffDbl(v24,v25,v26,v27, ld55a, ld55b);
        (int v32,int v33,int v34,int v35) = g2AffAdd(v28,v29,v30,v31, Bxa,Bxb,Bya,Byb, la55a, la55b);
        (int v36,int v37,int v38,int v39) = g2AffDbl(v32,v33,v34,v35, ld56a, ld56b);
        (int v40,int v41,int v42,int v43) = g2AffAdd(v36,v37,v38,v39, Bxa,Bxb,Bya,Byb, la56a, la56b);
        (int v44,int v45,int v46,int v47) = g2AffDbl(v40,v41,v42,v43, ld57a, ld57b);
        (int v48,int v49,int v50,int v51) = g2AffAdd(v44,v45,v46,v47, Bxa,Bxb,Bya,Byb, la57a, la57b);
        (int v52,int v53,int v54,int v55) = g2AffDbl(v48,v49,v50,v51, ld58a, ld58b);
        (int v56,int v57,int v58,int v59) = g2AffAdd(v52,v53,v54,v55, Bxa,Bxb,Bya,Byb, la58a, la58b);
        (int v60,int v61,int v62,int v63) = g2AffDbl(v56,v57,v58,v59, ld59a, ld59b);
        (int v64,int v65,int v66,int v67) = g2AffDbl(v60,v61,v62,v63, ld60a, ld60b);
        (int v68,int v69,int v70,int v71) = g2AffDbl(v64,v65,v66,v67, ld61a, ld61b);
        (int v72,int v73,int v74,int v75) = g2AffDbl(v68,v69,v70,v71, ld62a, ld62b);
        (int v76,int v77,int v78,int v79) = g2AffAdd(v72,v73,v74,v75, Bxa,Bxb,Bya,Byb, la62a, la62b);
        (int bxa,int bxb,int bya,int byb) = psi(v76, v77, v78, v79);
        (int cxa,int cxb,int cya,int cyb) = psi(bxa, bxb, bya, byb);
        (int dxa,int dxb,int dya,int dyb) = psi(cxa, cxb, cya, cyb);
        (int l1xa,int l1xb,int l1ya,int l1yb) = g2AffAdd(v76, v77, v78, v79, Bxa, Bxb, Bya, Byb, le1a, le1b);
        (int l2xa,int l2xb,int l2ya,int l2yb) = g2AffAdd(l1xa, l1xb, l1ya, l1yb, bxa, bxb, bya, byb, le2a, le2b);
        (int l3xa,int l3xb,int l3ya,int l3yb) = g2AffAdd(l2xa, l2xb, l2ya, l2yb, cxa, cxb, cya, cyb, le3a, le3b);
        (int rxa,int rxb,int rya,int ryb) = g2AffDbl(dxa, dxb, dya, dyb, lera, lerb);
        require(l3xa == rxa); require(l3xb == rxb); require(l3ya == rya); require(l3yb == ryb);
        int Pmod = 21888242871839275222246405745257275088696311157297823662689037894645226208583;
        require(tx.outputs[0].nftCommitment == hash256((((toPaddedBytes(nAx % Pmod, 40) + toPaddedBytes(nAy % Pmod, 40)) + (toPaddedBytes(Bxa % Pmod, 40) + (toPaddedBytes(Bxb % Pmod, 40) + toPaddedBytes(Bya % Pmod, 40)))) + ((toPaddedBytes(Byb % Pmod, 40) + toPaddedBytes(Cx % Pmod, 40)) + (toPaddedBytes(Cy % Pmod, 40) + (toPaddedBytes(input0 % Pmod, 40) + toPaddedBytes(input1 % Pmod, 40)))))));
        require(tx.outputs[0].tokenCategory == tx.inputs[this.activeInputIndex].tokenCategory);
        require(tx.outputs.length == 1);
        require(tx.outputs[0].lockingBytecode == 0xaa2002d80ab7798ff08b5cae34df6c56eb07e577d829c6e09da00567c8bfa85a4c1387);
    }
}
