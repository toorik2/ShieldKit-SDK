pragma cashscript ^0.14.0;
import "../../../singleton/bn254/lib/Miller_aff.cash";
contract G2CheckAff() {
    function spend(int RXa,int RXb,int RYa,int RYb,int Bxa,int Bxb,int Bya,int Byb,int nAx,int nAy,int Cx,int Cy,int input0,int input1,int ld1a,int ld1b,int ld2a,int ld2b,int ld3a,int ld3b,int ld4a,int ld4b,int la4a,int la4b,int ld5a,int ld5b,int ld6a,int ld6b,int ld7a,int ld7b,int la7a,int la7b,int ld8a,int ld8b,int la8a,int la8b,int ld9a,int ld9b,int la9a,int la9b,int ld10a,int ld10b,int ld11a,int ld11b,int la11a,int la11b,int ld12a,int ld12b,int ld13a,int ld13b,int ld14a,int ld14b,int la14a,int la14b,int ld15a,int ld15b,int la15a,int la15b,int ld16a,int ld16b,int ld17a,int ld17b,int ld18a,int ld18b,int la18a,int la18b,int ld19a,int ld19b,int ld20a,int ld20b,int ld21a,int ld21b,int la21a,int la21b,int ld22a,int ld22b,int ld23a,int ld23b,int la23a,int la23b,int ld24a,int ld24b, bytes unused zeroPadding) {
        require(tx.inputs[this.activeInputIndex].nftCommitment == hash256((((toPaddedBytes(RXa, 40) + (toPaddedBytes(RXb, 40) + toPaddedBytes(RYa, 40))) + ((toPaddedBytes(RYb, 40) + toPaddedBytes(Bxa, 40)) + (toPaddedBytes(Bxb, 40) + toPaddedBytes(Bya, 40)))) + ((toPaddedBytes(Byb, 40) + (toPaddedBytes(nAx, 40) + toPaddedBytes(nAy, 40))) + ((toPaddedBytes(Cx, 40) + toPaddedBytes(Cy, 40)) + (toPaddedBytes(input0, 40) + toPaddedBytes(input1, 40)))))));
        require(RXa == Bxa); require(RXb == Bxb); require(RYa == Bya); require(RYb == Byb);
        require(mulFp(nAy, nAy) == addFp(mulFp(mulFp(nAx, nAx), nAx), 3));
        require(mulFp(Cy, Cy) == addFp(mulFp(mulFp(Cx, Cx), Cx), 3));
        (int oxa,int oxb) = fp2Sqr(Bxa, Bxb);
        (int oya,int oyb) = fp2Mul(oxa, oxb, Bxa, Bxb);
        (int ora,int orb) = fp2Add(oya, oyb, 19485874751759354771024239261021720505790618469301721065564631296452457478373, 266929791119991161246907387137283842545076965332900288569378510910307636690);
        (int oba,int obb) = fp2Sqr(Bya, Byb);
        require(oba == ora); require(obb == orb);
        (int v0,int v1,int v2,int v3) = g2AffDbl(RXa,RXb,RYa,RYb, ld1a, ld1b);
        (int v4,int v5,int v6,int v7) = g2AffDbl(v0,v1,v2,v3, ld2a, ld2b);
        (int v8,int v9,int v10,int v11) = g2AffDbl(v4,v5,v6,v7, ld3a, ld3b);
