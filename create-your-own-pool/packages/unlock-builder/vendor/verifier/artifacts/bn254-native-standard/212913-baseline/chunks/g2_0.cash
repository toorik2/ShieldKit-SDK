        (int v16,int v17,int v18,int v19) = g2AffAdd(v12,v13,v14,v15, Bxa,Bxb,Bya,Byb, la4a, la4b);
        (int v20,int v21,int v22,int v23) = g2AffDbl(v16,v17,v18,v19, ld5a, ld5b);
        (int v24,int v25,int v26,int v27) = g2AffDbl(v20,v21,v22,v23, ld6a, ld6b);
        (int v28,int v29,int v30,int v31) = g2AffDbl(v24,v25,v26,v27, ld7a, ld7b);
        (int v32,int v33,int v34,int v35) = g2AffAdd(v28,v29,v30,v31, Bxa,Bxb,Bya,Byb, la7a, la7b);
        (int v36,int v37,int v38,int v39) = g2AffDbl(v32,v33,v34,v35, ld8a, ld8b);
        (int v40,int v41,int v42,int v43) = g2AffAdd(v36,v37,v38,v39, Bxa,Bxb,Bya,Byb, la8a, la8b);
        (int v44,int v45,int v46,int v47) = g2AffDbl(v40,v41,v42,v43, ld9a, ld9b);
        (int v48,int v49,int v50,int v51) = g2AffAdd(v44,v45,v46,v47, Bxa,Bxb,Bya,Byb, la9a, la9b);
        (int v52,int v53,int v54,int v55) = g2AffDbl(v48,v49,v50,v51, ld10a, ld10b);
        (int v56,int v57,int v58,int v59) = g2AffDbl(v52,v53,v54,v55, ld11a, ld11b);
        (int v60,int v61,int v62,int v63) = g2AffAdd(v56,v57,v58,v59, Bxa,Bxb,Bya,Byb, la11a, la11b);
        (int v64,int v65,int v66,int v67) = g2AffDbl(v60,v61,v62,v63, ld12a, ld12b);
        (int v68,int v69,int v70,int v71) = g2AffDbl(v64,v65,v66,v67, ld13a, ld13b);
        (int v72,int v73,int v74,int v75) = g2AffDbl(v68,v69,v70,v71, ld14a, ld14b);
        (int v76,int v77,int v78,int v79) = g2AffAdd(v72,v73,v74,v75, Bxa,Bxb,Bya,Byb, la14a, la14b);
        (int v80,int v81,int v82,int v83) = g2AffDbl(v76,v77,v78,v79, ld15a, ld15b);
        (int v84,int v85,int v86,int v87) = g2AffAdd(v80,v81,v82,v83, Bxa,Bxb,Bya,Byb, la15a, la15b);
        (int v88,int v89,int v90,int v91) = g2AffDbl(v84,v85,v86,v87, ld16a, ld16b);
        (int v92,int v93,int v94,int v95) = g2AffDbl(v88,v89,v90,v91, ld17a, ld17b);
        (int v96,int v97,int v98,int v99) = g2AffDbl(v92,v93,v94,v95, ld18a, ld18b);
        (int v100,int v101,int v102,int v103) = g2AffAdd(v96,v97,v98,v99, Bxa,Bxb,Bya,Byb, la18a, la18b);
        (int v104,int v105,int v106,int v107) = g2AffDbl(v100,v101,v102,v103, ld19a, ld19b);
        (int v108,int v109,int v110,int v111) = g2AffDbl(v104,v105,v106,v107, ld20a, ld20b);
        (int v112,int v113,int v114,int v115) = g2AffDbl(v108,v109,v110,v111, ld21a, ld21b);
        (int v116,int v117,int v118,int v119) = g2AffAdd(v112,v113,v114,v115, Bxa,Bxb,Bya,Byb, la21a, la21b);
        (int v120,int v121,int v122,int v123) = g2AffDbl(v116,v117,v118,v119, ld22a, ld22b);
        (int v124,int v125,int v126,int v127) = g2AffDbl(v120,v121,v122,v123, ld23a, ld23b);
        (int v128,int v129,int v130,int v131) = g2AffAdd(v124,v125,v126,v127, Bxa,Bxb,Bya,Byb, la23a, la23b);
        (int v132,int v133,int v134,int v135) = g2AffDbl(v128,v129,v130,v131, ld24a, ld24b);
        int Pmod = 21888242871839275222246405745257275088696311157297823662689037894645226208583;
        require(tx.outputs[0].nftCommitment == hash256((((toPaddedBytes(v132 % Pmod, 40) + (toPaddedBytes(v133 % Pmod, 40) + toPaddedBytes(v134 % Pmod, 40))) + ((toPaddedBytes(v135 % Pmod, 40) + toPaddedBytes(Bxa % Pmod, 40)) + (toPaddedBytes(Bxb % Pmod, 40) + toPaddedBytes(Bya % Pmod, 40)))) + ((toPaddedBytes(Byb % Pmod, 40) + (toPaddedBytes(nAx % Pmod, 40) + toPaddedBytes(nAy % Pmod, 40))) + ((toPaddedBytes(Cx % Pmod, 40) + toPaddedBytes(Cy % Pmod, 40)) + (toPaddedBytes(input0 % Pmod, 40) + toPaddedBytes(input1 % Pmod, 40)))))));
        require(tx.outputs[0].tokenCategory == tx.inputs[this.activeInputIndex].tokenCategory);
        require(tx.outputs.length == 1);
        require(tx.outputs[0].lockingBytecode == 0xaa20c29a30234b0234c5c78377eceec962ddd7cda4a5223f7e1dda5c1490e3e12c2387);
    }
