pragma cashscript ^0.14.0;
function addFp(int x,int y) returns(int){return (x+y)%21888242871839275222246405745257275088696311157297823662689037894645226208583;}
function subFp(int x,int y) returns(int){return (x-y+21888242871839275222246405745257275088696311157297823662689037894645226208583)%21888242871839275222246405745257275088696311157297823662689037894645226208583;}
function mulFp(int x,int y) returns(int){return (x*y)%21888242871839275222246405745257275088696311157297823662689037894645226208583;}
function fp2Mul(int a0,int a1,int b0,int b1) returns(int,int){int v0=mulFp(a0,b0);int v1=mulFp(a1,b1);return subFp(v0,v1),subFp(mulFp(addFp(a0,a1),addFp(b0,b1)),addFp(v0,v1));}
function fp2Add(int a0,int a1,int b0,int b1) returns(int,int){return addFp(a0,b0),addFp(a1,b1);}
contract VkxEcip() {
    function spend(int nAx,int nAy,int Bxa,int Bxb,int Bya,int Byb,int Cx,int Cy,int in0,int in1,int Qx,int Qy,int an0,int an1,int an2,int an3,int ad0,int ad1,int ad2,int ad3,int ad4,int bn0,int bn1,int bn2,int bn3,int bn4,int bd0,int bd1,int bd2,int bd3,int bd4,int bd5,int bd6,int bd7,int yA0,int nfail,int gr0,int gr1,int gr2,int gr3,int gr4,int gr5,int gr6,int gr7,int mA0,int mA0A2,int coeff2,int iad0,int ibd0,int iad2,int ibd2,int t0p,int t0n,int t1p,int t1n,int t2p,int t2n,int tQ, bytes unused zeroPadding) {
        int Pmod = 21888242871839275222246405745257275088696311157297823662689037894645226208583;
        require(tx.inputs[this.activeInputIndex].nftCommitment == hash256(toPaddedBytes(nAx, 40) + toPaddedBytes(nAy, 40) + toPaddedBytes(Bxa, 40) + toPaddedBytes(Bxb, 40) + toPaddedBytes(Bya, 40) + toPaddedBytes(Byb, 40) + toPaddedBytes(Cx, 40) + toPaddedBytes(Cy, 40) + toPaddedBytes(in0, 40) + toPaddedBytes(in1, 40)));
        require(in0 < 21888242871839275222246405745257275088548364400416034343698204186575808495617); require(in1 < 21888242871839275222246405745257275088548364400416034343698204186575808495617);
        require(mulFp(nAy, nAy) == addFp(mulFp(mulFp(nAx, nAx), nAx), 3));
        require(mulFp(Cy, Cy) == addFp(mulFp(mulFp(Cx, Cx), Cx), 3));
        (int oxa,int oxb) = fp2Mul(Bxa, Bxb, Bxa, Bxb);
        (int oya,int oyb) = fp2Mul(oxa, oxb, Bxa, Bxb);
        (int ora,int orb) = fp2Add(oya, oyb, 19485874751759354771024239261021720505790618469301721065564631296452457478373, 266929791119991161246907387137283842545076965332900288569378510910307636690);
        (int oba,int obb) = fp2Mul(Bya, Byb, Bya, Byb);
        require(oba == ora); require(obb == orb);
        require(Qx >= 0); require(Qx < Pmod);
        require(Qy >= 0); require(Qy < Pmod);
        require(an0 >= 0); require(an0 < Pmod);
        require(an1 >= 0); require(an1 < Pmod);
        require(an2 >= 0); require(an2 < Pmod);
        require(an3 >= 0); require(an3 < Pmod);
        require(ad0 >= 0); require(ad0 < Pmod);
        require(ad1 >= 0); require(ad1 < Pmod);
        require(ad2 >= 0); require(ad2 < Pmod);
        require(ad3 >= 0); require(ad3 < Pmod);
        require(ad4 >= 0); require(ad4 < Pmod);
        require(bn0 >= 0); require(bn0 < Pmod);
        require(bn1 >= 0); require(bn1 < Pmod);
        require(bn2 >= 0); require(bn2 < Pmod);
        require(bn3 >= 0); require(bn3 < Pmod);
        require(bn4 >= 0); require(bn4 < Pmod);
        require(bd0 >= 0); require(bd0 < Pmod);
        require(bd1 >= 0); require(bd1 < Pmod);
        require(bd2 >= 0); require(bd2 < Pmod);
        require(bd3 >= 0); require(bd3 < Pmod);
        require(bd4 >= 0); require(bd4 < Pmod);
        require(bd5 >= 0); require(bd5 < Pmod);
        require(bd6 >= 0); require(bd6 < Pmod);
        require(bd7 >= 0); require(bd7 < Pmod);
        int cseed = int(bytes(sha256(toPaddedBytes(in0, 32) + toPaddedBytes(in1, 32) + toPaddedBytes(Qx, 32) + toPaddedBytes(Qy, 32) + toPaddedBytes(an0, 32) + toPaddedBytes(an1, 32) + toPaddedBytes(an2, 32) + toPaddedBytes(an3, 32) + toPaddedBytes(ad0, 32) + toPaddedBytes(ad1, 32) + toPaddedBytes(ad2, 32) + toPaddedBytes(ad3, 32) + toPaddedBytes(ad4, 32) + toPaddedBytes(bn0, 32) + toPaddedBytes(bn1, 32) + toPaddedBytes(bn2, 32) + toPaddedBytes(bn3, 32) + toPaddedBytes(bn4, 32) + toPaddedBytes(bd0, 32) + toPaddedBytes(bd1, 32) + toPaddedBytes(bd2, 32) + toPaddedBytes(bd3, 32) + toPaddedBytes(bd4, 32) + toPaddedBytes(bd5, 32) + toPaddedBytes(bd6, 32) + toPaddedBytes(bd7, 32)).split(31)[0]));
        int x = cseed % Pmod; if (x < 0) { x = x + Pmod; }
        require(nfail >= 0); require(nfail <= 8);
        if (nfail > 0) { require(mulFp(gr0, gr0) == mulFp(3, addFp(mulFp(mulFp(x,x),x), 3)));
            int hc0 = int(bytes(sha256(toPaddedBytes(x, 32)).split(31)[0])); x = hc0 % Pmod; if (x < 0) { x = x + Pmod; } }
        if (nfail > 1) { require(mulFp(gr1, gr1) == mulFp(3, addFp(mulFp(mulFp(x,x),x), 3)));
            int hc1 = int(bytes(sha256(toPaddedBytes(x, 32)).split(31)[0])); x = hc1 % Pmod; if (x < 0) { x = x + Pmod; } }
        if (nfail > 2) { require(mulFp(gr2, gr2) == mulFp(3, addFp(mulFp(mulFp(x,x),x), 3)));
            int hc2 = int(bytes(sha256(toPaddedBytes(x, 32)).split(31)[0])); x = hc2 % Pmod; if (x < 0) { x = x + Pmod; } }
        if (nfail > 3) { require(mulFp(gr3, gr3) == mulFp(3, addFp(mulFp(mulFp(x,x),x), 3)));
            int hc3 = int(bytes(sha256(toPaddedBytes(x, 32)).split(31)[0])); x = hc3 % Pmod; if (x < 0) { x = x + Pmod; } }
        if (nfail > 4) { require(mulFp(gr4, gr4) == mulFp(3, addFp(mulFp(mulFp(x,x),x), 3)));
            int hc4 = int(bytes(sha256(toPaddedBytes(x, 32)).split(31)[0])); x = hc4 % Pmod; if (x < 0) { x = x + Pmod; } }
        if (nfail > 5) { require(mulFp(gr5, gr5) == mulFp(3, addFp(mulFp(mulFp(x,x),x), 3)));
            int hc5 = int(bytes(sha256(toPaddedBytes(x, 32)).split(31)[0])); x = hc5 % Pmod; if (x < 0) { x = x + Pmod; } }
        if (nfail > 6) { require(mulFp(gr6, gr6) == mulFp(3, addFp(mulFp(mulFp(x,x),x), 3)));
            int hc6 = int(bytes(sha256(toPaddedBytes(x, 32)).split(31)[0])); x = hc6 % Pmod; if (x < 0) { x = x + Pmod; } }
        if (nfail > 7) { require(mulFp(gr7, gr7) == mulFp(3, addFp(mulFp(mulFp(x,x),x), 3)));
            int hc7 = int(bytes(sha256(toPaddedBytes(x, 32)).split(31)[0])); x = hc7 % Pmod; if (x < 0) { x = x + Pmod; } }
        int xA0 = x;
        require(mulFp(yA0, yA0) == addFp(mulFp(mulFp(xA0,xA0),xA0), 3));
        require(mulFp(mulFp(2, yA0), mA0) == mulFp(3, mulFp(xA0, xA0)));
        int bA0 = subFp(yA0, mulFp(mA0, xA0));
        int x2d = subFp(mulFp(mA0, mA0), mulFp(2, xA0));
        int y2d = subFp(mulFp(mA0, subFp(xA0, x2d)), yA0);
        int xA2 = x2d; int yA2 = subFp(0, y2d);
        require(mulFp(mA0A2, subFp(xA2, xA0)) == subFp(yA2, yA0));
        require(mulFp(coeff2, subFp(mulFp(3, mulFp(xA2, xA2)), mulFp(2, mulFp(mA0A2, yA2)))) == mulFp(2, mulFp(yA2, subFp(xA0, xA2))));
        int coeff0 = addFp(coeff2, mulFp(2, mA0A2));
        int s0 = in0; int ep0 = 0; int en0 = 0; int s1 = in1; int ep1 = 0; int en1 = 0; int pw = 1;
        for (int k = 0; k < 161; k = k + 1) { if (s0 != 0 || s1 != 0) {
            int r0 = s0 % 3; if (r0 < 0) { r0 = r0 + 3; } int d0 = 0; if (r0 == 2) { d0 = -1; } else { d0 = r0; }
            if (d0 == 1) { ep0 = ep0 + pw; } if (d0 == -1) { en0 = en0 + pw; } s0 = (d0 - s0) / 3;
            int r1 = s1 % 3; if (r1 < 0) { r1 = r1 + 3; } int d1 = 0; if (r1 == 2) { d1 = -1; } else { d1 = r1; }
            if (d1 == 1) { ep1 = ep1 + pw; } if (d1 == -1) { en1 = en1 + pw; } s1 = (d1 - s1) / 3; pw = 0 - (3 * pw); } }
        require(s0 == 0); require(s1 == 0);
        int ep0m = ep0 % Pmod; if (ep0m < 0) { ep0m = ep0m + Pmod; } int en0m = en0 % Pmod; if (en0m < 0) { en0m = en0m + Pmod; }
        int ep1m = ep1 % Pmod; if (ep1m < 0) { ep1m = ep1m + Pmod; } int en1m = en1 % Pmod; if (en1m < 0) { en1m = en1m + Pmod; }
        int mxt0p = mulFp(mA0, 15723390722547469201346605927630336729729463607293657950235977012003655267936);
        require(mulFp(t0p, subFp(subFp(14617976463853845616027311884626760527376622737858716767193455441349641383825, mxt0p), bA0)) == mulFp(1, subFp(xA0, 15723390722547469201346605927630336729729463607293657950235977012003655267936)));
        require(mulFp(t0n, subFp(subFp(subFp(0, 14617976463853845616027311884626760527376622737858716767193455441349641383825), mxt0p), bA0)) == mulFp(0, subFp(xA0, 15723390722547469201346605927630336729729463607293657950235977012003655267936)));
        int mxt1p = mulFp(mA0, 9269869340829791644953940526610795845982127221382366381974052273854848284744);
        require(mulFp(t1p, subFp(subFp(12340830433822638848259976740304056841548514693917037023437897137808450264577, mxt1p), bA0)) == mulFp(ep0m, subFp(xA0, 9269869340829791644953940526610795845982127221382366381974052273854848284744)));
        require(mulFp(t1n, subFp(subFp(subFp(0, 12340830433822638848259976740304056841548514693917037023437897137808450264577), mxt1p), bA0)) == mulFp(en0m, subFp(xA0, 9269869340829791644953940526610795845982127221382366381974052273854848284744)));
        int mxt2p = mulFp(mA0, 6442706084407552401539720969529928260622245802604045626376932056434206076947);
        require(mulFp(t2p, subFp(subFp(13805589277496019078136496656829548863642318729315912795941464570275337353000, mxt2p), bA0)) == mulFp(ep1m, subFp(xA0, 6442706084407552401539720969529928260622245802604045626376932056434206076947)));
        require(mulFp(t2n, subFp(subFp(subFp(0, 13805589277496019078136496656829548863642318729315912795941464570275337353000), mxt2p), bA0)) == mulFp(en1m, subFp(xA0, 6442706084407552401539720969529928260622245802604045626376932056434206076947)));
        int mxQ = mulFp(mA0, Qx);
        require(mulFp(tQ, subFp(subFp(subFp(0, Qy), mxQ), bA0)) == subFp(xA0, Qx));
        int RHS = addFp(tQ, addFp(addFp(t0p, t0n), addFp(addFp(t1p, t1n), addFp(t2p, t2n))));
        int adA0 = addFp(mulFp(addFp(mulFp(addFp(mulFp(addFp(mulFp(ad4,xA0),ad3),xA0),ad2),xA0),ad1),xA0),ad0); require(mulFp(adA0, iad0) == 1);
        int bdA0 = addFp(mulFp(addFp(mulFp(addFp(mulFp(addFp(mulFp(addFp(mulFp(addFp(mulFp(addFp(mulFp(bd7,xA0),bd6),xA0),bd5),xA0),bd4),xA0),bd3),xA0),bd2),xA0),bd1),xA0),bd0); require(mulFp(bdA0, ibd0) == 1);
        int adA2 = addFp(mulFp(addFp(mulFp(addFp(mulFp(addFp(mulFp(ad4,xA2),ad3),xA2),ad2),xA2),ad1),xA2),ad0); require(mulFp(adA2, iad2) == 1);
        int bdA2 = addFp(mulFp(addFp(mulFp(addFp(mulFp(addFp(mulFp(addFp(mulFp(addFp(mulFp(addFp(mulFp(bd7,xA2),bd6),xA2),bd5),xA2),bd4),xA2),bd3),xA2),bd2),xA2),bd1),xA2),bd0); require(mulFp(bdA2, ibd2) == 1);
        int fA0 = addFp(mulFp(addFp(mulFp(addFp(mulFp(addFp(mulFp(an3,xA0),an2),xA0),an1),xA0),an0), iad0), mulFp(yA0, mulFp(addFp(mulFp(addFp(mulFp(addFp(mulFp(addFp(mulFp(bn4,xA0),bn3),xA0),bn2),xA0),bn1),xA0),bn0), ibd0)));
        int fA2 = addFp(mulFp(addFp(mulFp(addFp(mulFp(addFp(mulFp(an3,xA2),an2),xA2),an1),xA2),an0), iad2), mulFp(yA2, mulFp(addFp(mulFp(addFp(mulFp(addFp(mulFp(addFp(mulFp(bn4,xA2),bn3),xA2),bn2),xA2),bn1),xA2),bn0), ibd2)));
        int LHS = subFp(mulFp(coeff0, fA0), mulFp(coeff2, fA2));
        require(LHS == RHS);
        int vkxX = Qx; int vkxY = Qy;
        require(tx.outputs[0].nftCommitment == hash256(toPaddedBytes(nAx % Pmod, 40) + toPaddedBytes(nAy % Pmod, 40) + toPaddedBytes(Bxa % Pmod, 40) + toPaddedBytes(Bxb % Pmod, 40) + toPaddedBytes(Bya % Pmod, 40) + toPaddedBytes(Byb % Pmod, 40) + toPaddedBytes(vkxX % Pmod, 40) + toPaddedBytes(vkxY % Pmod, 40) + toPaddedBytes(Cx % Pmod, 40) + toPaddedBytes(Cy % Pmod, 40)));
        require(tx.outputs[0].tokenCategory == tx.inputs[this.activeInputIndex].tokenCategory);
        require(tx.outputs.length == 1);
        require(tx.outputs[0].lockingBytecode == 0xaa20dc9521936ac5fdbe65ed720d609c82f6a6b5a59293cf01622c585237a3e7459d87);
    }
}
