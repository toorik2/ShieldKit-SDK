{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shield.cash/schema/evidence/v1",
  "title": "shield.cash gate evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "gate",
    "candidate",
    "claim",
    "source",
    "environment",
    "commands",
    "artifacts",
    "verdict",
    "limitations"
  ],
  "properties": {
    "schema": {
      "const": "shield.cash/evidence/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "gate": {
      "enum": ["G1", "G2", "G3", "G4", "G5", "G6", "G7", "G8", "G9"]
    },
    "candidate": {
      "type": "string",
      "minLength": 1
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "dirtyPaths"],
      "properties": {
        "repository": {"type": "string"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "dirtyPaths": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        }
      }
    },
    "environment": {
      "type": "object",
      "required": ["observedAt", "hardware", "software"],
      "properties": {
        "observedAt": {"type": "string", "format": "date-time"},
        "hardware": {"type": "object"},
        "software": {"type": "object"}
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "measurements": {
      "type": "object"
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "expected", "observed", "pass"],
        "properties": {
          "name": {"type": "string"},
          "expected": {},
          "observed": {},
          "pass": {"type": "boolean"}
        }
      }
    },
    "verdict": {
      "enum": ["PASS", "FAIL"]
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
