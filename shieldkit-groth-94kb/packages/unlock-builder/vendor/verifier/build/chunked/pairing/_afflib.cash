// S3 witnessed-affine EC check-back for pair0 (BN254 Miller). Prover WITNESSES the slope lam;
// the point is DERIVED (division-free) and the slope VERIFIED, so lam is uniquely forced and the
// next point equals 2R (doubling) / R+Q (add). Outputs xn,yn reduced to [0,p). c0,c1,c2 line
// coeffs match pointDouble/pointAdd at Z=1 (verified vs noble) so the folded f is a valid Miller value.
function affDbl(int xa,int xb, int ya,int yb, int la,int lb) returns (int,int,int,int,int,int, int,int,int,int) {
    int Pm = 21888242871839275222246405745257275088696311157297823662689037894645226208583;
    (int x2a,int x2b) = fp2Sqr(xa,xb);
    (int c1a,int c1b) = fp2Scale(x2a,x2b,3);              // c1 = 3x^2
    (int cka,int ckb) = fp2Mul(la,lb, addFp(ya,ya), addFp(yb,yb)); // lam*2y
    require(cka % Pm == c1a % Pm); require(ckb % Pm == c1b % Pm);  // slope: lam*2y == 3x^2 (2y != 0)
    (int c2a,int c2b) = fp2Neg(addFp(ya,ya),addFp(yb,yb),64); // c2 = -2y
    (int yya,int yyb) = fp2Sqr(ya,yb);
    int rc0a = subFp(mulFp(3, 19485874751759354771024239261021720505790618469301721065564631296452457478373), yya, 1);
    int rc0b = subFp(mulFp(3, 266929791119991161246907387137283842545076965332900288569378510910307636690), yyb, 1);
    (int l2a,int l2b) = fp2Sqr(la,lb);
    int xna = (subFp(l2a, addFp(xa,xa), 2)) % Pm;         // xn = lam^2 - 2x
    int xnb = (subFp(l2b, addFp(xb,xb), 2)) % Pm;
    (int lya,int lyb) = fp2Mul(la,lb, subFp(xa,xna,1), subFp(xb,xnb,1)); // lam*(x-xn)
    int yna = (subFp(lya, ya, 1)) % Pm;                   // yn = lam*(x-xn) - y
    int ynb = (subFp(lyb, yb, 1)) % Pm;
    return rc0a,rc0b,c1a,c1b,c2a,c2b, xna,xnb,yna,ynb;
}
function affAdd(int Rxa,int Rxb,int Rya,int Ryb, int Qxa,int Qxb,int Qya,int Qyb, int la,int lb) returns (int,int,int,int,int,int, int,int,int,int) {
    int Pm = 21888242871839275222246405745257275088696311157297823662689037894645226208583;
    require((Rxa - Qxa) % Pm != 0 || (Rxb - Qxb) % Pm != 0);   // R != +-Q (Rx != Qx)
    (int t1a,int t1b) = fp2Sub(Rxa,Rxb,Qxa,Qxb,64);            // t1 = Rx-Qx
    (int t0a,int t0b) = fp2Sub(Rya,Ryb,Qya,Qyb,64);           // t0 = Ry-Qy
    (int cka,int ckb) = fp2Mul(la,lb, t1a,t1b);               // lam*(Rx-Qx)
    require(cka % Pm == t0a % Pm); require(ckb % Pm == t0b % Pm); // slope: lam*(Rx-Qx) == Ry-Qy
    (int q0a,int q0b) = fp2Mul(t0a,t0b, Qxa,Qxb);
    (int q1a,int q1b) = fp2Mul(t1a,t1b, Qya,Qyb);
    (int c0a,int c0b) = fp2Sub(q0a,q0b,q1a,q1b,3);            // c0 = t0*Qx - t1*Qy
    (int c1a,int c1b) = fp2Neg(t0a,t0b,64);                   // c1 = -t0
    int c2a = t1a; int c2b = t1b;                             // c2 = t1
    (int l2a,int l2b) = fp2Sqr(la,lb);
    int xna = (subFp(subFp(l2a, Rxa, 64), Qxa, 64)) % Pm;    // xn = lam^2 - Rx - Qx
    int xnb = (subFp(subFp(l2b, Rxb, 64), Qxb, 64)) % Pm;
    (int lya,int lyb) = fp2Mul(la,lb, subFp(Rxa,xna,1), subFp(Rxb,xnb,1)); // lam*(Rx-xn)
    int yna = (subFp(lya, Rya, 1)) % Pm;                      // yn = lam*(Rx-xn) - Ry
    int ynb = (subFp(lyb, Ryb, 1)) % Pm;
    return c0a,c0b,c1a,c1b,c2a,c2b, xna,xnb,yna,ynb;
}
