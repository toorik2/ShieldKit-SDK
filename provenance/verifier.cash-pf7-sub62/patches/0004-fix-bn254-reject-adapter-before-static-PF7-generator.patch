From 971b0ff6e7709bb877a78c851ccd42a62cad8f36 Mon Sep 17 00:00:00 2001
From: Margus Kokk <margus.kokk@gmail.com>
Date: Thu, 23 Jul 2026 17:47:29 +0300
Subject: [PATCH 4/7] fix(bn254): reject adapter before static PF7 generators

---
 lanes/bn254-onetx/src/c7/build.ts                    | 10 ++++++++++
 lanes/bn254-onetx/test/shield-adapter-input.test.mjs |  9 +++++++++
 2 files changed, 19 insertions(+)

diff --git a/lanes/bn254-onetx/src/c7/build.ts b/lanes/bn254-onetx/src/c7/build.ts
index c1f5a6c..75a5f34 100644
--- a/lanes/bn254-onetx/src/c7/build.ts
+++ b/lanes/bn254-onetx/src/c7/build.ts
@@ -22,6 +22,16 @@ const here = dirname(fileURLToPath(import.meta.url));
 const repoRoot = resolve(here, '../../../..');
 const buildRequire = createRequire(join(repoRoot, 'build/package.json'));
 const CONFIG = readLegacyC7Config(process.env, { here, repoRoot });
+// This source builder is not parameterized end-to-end: its gb3/SZ (and
+// FIXED_G2_TABLE) emitters construct literal trajectories from _szmath's
+// committed pairing vectors. Loading an arbitrary adapter VK after importing
+// those modules would silently mix its proof/IC with static gamma/delta,
+// alpha-beta, transcript, and chunk-state material. Refuse before *any* such
+// generator import. The standalone strict adapter loader remains reusable by a
+// future fully parameterized PF7 route; it is not authorization to build here.
+if (CONFIG.proofSelection.shieldAdapter) {
+  throw new Error('C7_SHIELD_ADAPTER_* is unavailable for this PF7 builder: gb3/SZ/FIXED_G2 generators retain static pairing-vector trajectories; refusing mixed VK/proof material');
+}
 // Generated CashScript imports are relocated to the shared singleton source before compilation.
 const GEN = CONFIG.paths.generated;
 mkdirSync(GEN, { recursive: true });
diff --git a/lanes/bn254-onetx/test/shield-adapter-input.test.mjs b/lanes/bn254-onetx/test/shield-adapter-input.test.mjs
index 0253cc2..81dea42 100644
--- a/lanes/bn254-onetx/test/shield-adapter-input.test.mjs
+++ b/lanes/bn254-onetx/test/shield-adapter-input.test.mjs
@@ -94,3 +94,12 @@ test('pinned import hashes the exact adapter bytes before parsing', async () =>
   assert.match(implementation, /bytesHash !== record\.sha256/);
   assert.match(implementation, /postReadHash !== record\.sha256/);
 });
+
+test('PF7 build rejects adapter selection before importing static trajectory generators', async () => {
+  const build = await readFile(new URL('../src/c7/build.ts', import.meta.url), 'utf8');
+  const guard = build.indexOf('C7_SHIELD_ADAPTER_* is unavailable for this PF7 builder');
+  const gb3Import = build.indexOf('const gb3: any = await import');
+  const szImport = build.indexOf('const sz: any = await import');
+  assert.ok(guard >= 0 && guard < gb3Import && guard < szImport, 'adapter guard must precede static trajectory imports');
+  assert.match(build, /gb3\/SZ \(and\n\/\/ FIXED_G2_TABLE\) emitters construct literal trajectories from _szmath/);
+});
-- 
