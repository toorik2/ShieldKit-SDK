    "qualification:v2:pf10-beta-libauth": "node 03-create-your-own-pool/scripts/v2-pf10-beta-libauth-qualification.mjs",
    "qualification:v2:beta-local-integration": "node 03-create-your-own-pool/scripts/v2-beta-local-integration.mjs",
    "beta:offline:pack": "node 03-create-your-own-pool/scripts/pack-v2-beta-offline-bundle.mjs",
    "beta:offline:install": "node 03-create-your-own-pool/scripts/install-v2-beta-offline-bundle.mjs",
    "qualification:v2:beta:live": "node 03-create-your-own-pool/scripts/v2-beta-live-qualification.mjs",
    "qualification:v2:beta:performance": "node 03-create-your-own-pool/scripts/v2-beta-live-performance.mjs",
    "qualification:v2:beta:pool-create-performance": "node 03-create-your-own-pool/scripts/v2-beta-live-pool-create-performance.mjs",
    "qualification:v2:beta:evidence-manifest:create": "node 03-create-your-own-pool/scripts/v2-beta-live-evidence-bundle-verify.mjs --create",
