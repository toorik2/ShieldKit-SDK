    "qualification:v2:q07:indexed-microbenchmark": "node 03-create-your-own-pool/scripts/v2-q07-indexed-microbenchmark.mjs",
    "q07:lifecycle-corpus:generate": "node 03-create-your-own-pool/scripts/v2-q07-lifecycle-corpus.mjs --output-directory",
    "q07:lifecycle-corpus:verify": "node 03-create-your-own-pool/scripts/v2-q07-lifecycle-corpus.mjs --verify",
    "q07:lifecycle:run": "node 03-create-your-own-pool/scripts/v2-q07-local-lifecycle-run.mjs --output-directory",
    "q07:lifecycle:verify": "node 03-create-your-own-pool/scripts/v2-q07-local-lifecycle-run.mjs --verify",
