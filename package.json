    "unlock-builder:smoke": "node 03-create-your-own-pool/packages/unlock-builder/smoke-golden.mjs",
    "create-pool": "node 03-create-your-own-pool/scripts/create-pool.mjs",
    "pack-pin-artifacts": "node 03-create-your-own-pool/scripts/pack-pin-artifacts.mjs",
    "fetch-pin-artifacts": "node 03-create-your-own-pool/scripts/fetch-pin-artifacts.mjs",
    "e2e:standalone": "node 03-create-your-own-pool/scripts/standalone-e2e-chipnet.mjs",
    "e2e:multiuser-blank": "node 03-create-your-own-pool/scripts/chipnet-multiuser-blank-e2e.mjs",
    "rpc:probe": "node 03-create-your-own-pool/scripts/rpc-probe.mjs",
    "test:pool": "node --test 03-create-your-own-pool/packages/pool/*.test.mjs",
    "audit:dependencies": "npm audit --audit-level=high",
    "check:source": "node 03-create-your-own-pool/scripts/check-source-policy.mjs",
    "test:formal": "bash 03-create-your-own-pool/packages/unlock-builder/vendor/lean/tools/opt-ci/verify.sh"
  },
  "devDependencies": {
    "circomlib": "2.0.5",
    "pnpm": "10.34.5",
    "typescript": "5.9.3",
    "yarn": "1.22.22"
  },
  "overrides": {
    "snarkjs@0.7.6": {
      "bfj": "9.1.3",
      "ejs": "6.0.1"
    },
    "ws": "8.21.1"
  }
}
