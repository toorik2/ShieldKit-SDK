    "qualification:external:chipnet": "node 03-create-your-own-pool/scripts/external-release-gate.mjs --gate chipnet",
    "qualification:external:final-ceremony-and-audits": "node 03-create-your-own-pool/scripts/external-release-gate.mjs --gate final-ceremony-and-audits",
    "shieldkit": "node 03-create-your-own-pool/scripts/shieldkit.mjs",
    "fetch-playground-bundle": "node 03-create-your-own-pool/scripts/fetch-playground-bundle.mjs",
    "version-check": "node 03-create-your-own-pool/scripts/shieldkit.mjs --version",
