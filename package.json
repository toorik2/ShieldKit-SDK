{
  "name": "shieldkit",
  "private": true,
  "version": "0.2.0",
  "description": "ShieldKit toolkit 0.2.0 — Unaudited WIP. Semver is code only; profiles/instances are content IDs.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "03-create-your-own-pool/packages/action",
    "03-create-your-own-pool/packages/kit",
    "03-create-your-own-pool/packages/pool",
    "03-create-your-own-pool/packages/profile",
    "03-create-your-own-pool/packages/prove",
    "03-create-your-own-pool/packages/recover",
    "03-create-your-own-pool/packages/unlock-builder",
    "03-create-your-own-pool/packages/v2-direct"
  ],
  "scripts": {
    "postinstall": "node 03-create-your-own-pool/scripts/install-deps.mjs",
    "install:deps": "npm ci --include-workspace-root",
    "test": "node 03-create-your-own-pool/scripts/run-domain-tests.mjs",
    "test:qualification:covenants": "node 03-create-your-own-pool/scripts/run-domain-tests.mjs --include-qualification",
    "test:live-fixtures": "SHIELDKIT_LIVE_FIXTURES=1 node --test 03-create-your-own-pool/packages/kit/pool-act-fail-closed.test.mjs",
    "shieldkit": "node 03-create-your-own-pool/scripts/shieldkit.mjs",
    "fetch-playground-bundle": "node 03-create-your-own-pool/scripts/fetch-playground-bundle.mjs",
    "version-check": "node 03-create-your-own-pool/scripts/shieldkit.mjs --version",
    "unlock-builder:setup": "node 03-create-your-own-pool/scripts/setup-unlock-toolchain.mjs",
    "unlock-builder:smoke": "node 03-create-your-own-pool/packages/unlock-builder/smoke-golden.mjs",
    "create-pool": "node 03-create-your-own-pool/scripts/create-pool.mjs",
    "pack-pin-artifacts": "node 03-create-your-own-pool/scripts/pack-pin-artifacts.mjs",
    "fetch-pin-artifacts": "node 03-create-your-own-pool/scripts/fetch-pin-artifacts.mjs",
    "e2e:standalone": "node 03-create-your-own-pool/scripts/standalone-e2e-chipnet.mjs",
    "e2e:multiuser-blank": "node 03-create-your-own-pool/scripts/chipnet-multiuser-blank-e2e.mjs",
    "rpc:probe": "node 03-create-your-own-pool/scripts/rpc-probe.mjs",
    "test:pool": "node --test 03-create-your-own-pool/packages/pool/*.test.mjs",
    "golden-path": "node -e \"console.log(require('fs').readFileSync('03-create-your-own-pool/docs/GOLDEN_PATH.md','utf8'))\"",
    "audit:dependencies": "npm audit --audit-level=high",
    "check:source": "node 03-create-your-own-pool/scripts/check-source-policy.mjs",
    "test:formal": "bash 03-create-your-own-pool/packages/unlock-builder/vendor/lean/tools/opt-ci/verify.sh",
    "test:v2-direct": "node --test 03-create-your-own-pool/packages/v2-direct/**/*.test.mjs 03-create-your-own-pool/packages/v2-direct/*.test.mjs",
    "v2-direct": "node 03-create-your-own-pool/packages/v2-direct/cli/shieldkit-v2.mjs",
    "protocol-v2": "node Protocol-design-v2/bin/shieldkit-v2.mjs",
    "test:protocol-v2": "node --test 03-create-your-own-pool/packages/v2-direct/cli/*.test.mjs 03-create-your-own-pool/packages/v2-direct/operator/funding-wallet.test.mjs"
  },
  "devDependencies": {
    "pnpm": "10.34.5",
    "yarn": "1.22.22"
  },
  "overrides": {
    "snarkjs@0.7.6": {
      "bfj": "9.1.3",
      "ejs": "6.0.1"
    },
    "ws": "8.21.1"
  }
}
