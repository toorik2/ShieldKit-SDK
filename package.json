{
  "name": "shieldkit",
  "private": true,
  "version": "0.2.0",
  "description": "ShieldKit toolkit 0.2.0 — Unaudited WIP. Semver is code only; profiles/instances are content IDs.",
  "type": "module",
  "bin": {
    "shieldkit": "03-create-your-own-pool/scripts/shieldkit.mjs"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "03-create-your-own-pool/packages/action",
    "03-create-your-own-pool/packages/kit",
    "03-create-your-own-pool/packages/pool",
    "03-create-your-own-pool/packages/profile",
    "03-create-your-own-pool/packages/prove",
    "03-create-your-own-pool/packages/recover",
    "03-create-your-own-pool/packages/unlock-builder"
  ],
  "scripts": {
    "postinstall": "node 03-create-your-own-pool/scripts/install-deps.mjs",
    "install:deps": "npm ci --include-workspace-root",
    "test": "node 03-create-your-own-pool/scripts/run-domain-tests.mjs --suite portable",
    "test:beta-product:security": "node 03-create-your-own-pool/scripts/run-domain-tests.mjs --suite beta-product-security",
    "test:qualification:beta-runtime": "node 03-create-your-own-pool/scripts/run-domain-tests.mjs --suite beta-runtime-qualification",
    "test:v2:circuit-model": "node --test 03-create-your-own-pool/packages/action/v2/circuit-model.test.mjs",
