{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verifier.cash/lane/v1",
  "type": "object",
  "required": ["schema", "id", "title", "frontierCandidate", "writeScope", "sharedReadOnly", "gates"],
  "properties": {
    "schema": { "const": "verifier.cash/lane/v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "frontierCandidate": { "type": "string", "minLength": 1 },
    "writeScope": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "sharedReadOnly": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "gates": {
      "type": "object",
      "required": ["fast", "qualification", "promotion"],
      "additionalProperties": false,
      "properties": {
        "fast": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "qualification": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "promotion": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    }
  }
}
