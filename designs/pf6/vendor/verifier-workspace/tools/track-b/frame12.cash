pragma cashscript ^0.13.0;

// Track B prize-sizing probe: a loop carrying a 12-int frame (like f in Fp12),
// reassigning ALL 12 every iteration via a CHEAP update (one add + one %p each).
// The field math is deliberately trivial so the FRAME-MANAGEMENT cost (cashc's
// O(depth) emitReplace store-backs for the 12 deep carried vars) dominates the
// decomp — letting us measure the store-back tax in isolation.
contract Frame12() {
    function spend(
        int a0,int a1,int a2,int a3,int a4,int a5,int a6,int a7,int a8,int a9,int a10,int a11,
        int n,
        int x0,int x1,int x2,int x3,int x4,int x5,int x6,int x7,int x8,int x9,int x10,int x11
    ) {
        for (int k = 0; k < n; k = k + 1) {
            int t0  = (a0  + a1 ) % 21888242871839275222246405745257275088696311157297823662689037894645226208583;
            int t1  = (a1  + a2 ) % 21888242871839275222246405745257275088696311157297823662689037894645226208583;
            int t2  = (a2  + a3 ) % 21888242871839275222246405745257275088696311157297823662689037894645226208583;
            int t3  = (a3  + a4 ) % 21888242871839275222246405745257275088696311157297823662689037894645226208583;
            int t4  = (a4  + a5 ) % 21888242871839275222246405745257275088696311157297823662689037894645226208583;
            int t5  = (a5  + a6 ) % 21888242871839275222246405745257275088696311157297823662689037894645226208583;
            int t6  = (a6  + a7 ) % 21888242871839275222246405745257275088696311157297823662689037894645226208583;
            int t7  = (a7  + a8 ) % 21888242871839275222246405745257275088696311157297823662689037894645226208583;
            int t8  = (a8  + a9 ) % 21888242871839275222246405745257275088696311157297823662689037894645226208583;
            int t9  = (a9  + a10) % 21888242871839275222246405745257275088696311157297823662689037894645226208583;
            int t10 = (a10 + a11) % 21888242871839275222246405745257275088696311157297823662689037894645226208583;
            int t11 = (a11 + a0 ) % 21888242871839275222246405745257275088696311157297823662689037894645226208583;
            a0=t0; a1=t1; a2=t2; a3=t3; a4=t4; a5=t5; a6=t6; a7=t7; a8=t8; a9=t9; a10=t10; a11=t11;
        }
        require(a0==x0); require(a1==x1); require(a2==x2); require(a3==x3); require(a4==x4); require(a5==x5);
        require(a6==x6); require(a7==x7); require(a8==x8); require(a9==x9); require(a10==x10); require(a11==x11);
    }
}
