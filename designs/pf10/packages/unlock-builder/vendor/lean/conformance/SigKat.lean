def main : IO UInt32 := do
  let (oracle, name) ← oracleFromEnv
  IO.println s!"ORACLE {name}"
  IO.println s!"CASES {cases.length}"
  let mut pass := 0
  let mut fail := 0
  for c in cases do
    let got := oracle.verifySchnorr c.sig c.pubkey c.digest
    if got == c.expect then
      pass := pass + 1
    else
      fail := fail + 1
      IO.println s!"FAIL [{c.label}] expected {c.expect} got {got}"
  IO.println s!"SIGKAT PASS {pass}/{cases.length} FAIL {fail}"
  return (if fail == 0 then 0 else 1)
